[gd_scene format=3 uid="uid://travelloc001"]

[ext_resource type="Script" path="res://scripts/world/travel_location.gd" id="1_location"]

[node name="TravelLocation" type="Node2D"]
script = ExtResource("1_location")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Panel" type="PanelContainer" parent="UI"]
offset_left = 300.0
offset_top = 150.0
offset_right = 980.0
offset_bottom = 570.0

[node name="VBox" type="VBoxContainer" parent="UI/Panel"]
layout_mode = 2
